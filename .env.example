# ─────────────────────────────────────────────
# SUPABASE (free tier — supabase.com)
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# AI — Google Gemini (free tier — aistudio.google.com)
# ─────────────────────────────────────────────
GEMINI_API_KEY=
# gemini-2.0-flash was deprecated and shut down June 1, 2026 — use 2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# META — Facebook app (legacy Facebook Page flow only)
# developers.facebook.com → App settings → Basic
# Per-client tokens live in Supabase (clients table),
# these are only used for local testing of a single client.
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ─────────────────────────────────────────────
# INSTAGRAM — "Instagram API with Instagram Login"
#
# THESE ARE NOT THE SAME AS META_APP_ID / META_APP_SECRET.
# The Instagram app is nested inside the Facebook app and has its
# own ID + secret. Find them at:
#   developers.facebook.com → your app → Use cases →
#   "Manage messaging & content on Instagram" → Customize →
#   "API setup with Instagram login" → Instagram app ID / secret
#
# Without these, /api/oauth/meta/start fails with meta_not_configured
# and no client can connect their Instagram account.
# ─────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Any random string you pick. Must match the "Verify token" you enter
# in the Instagram webhooks config (Meta dashboard step 3).
META_VERIFY_TOKEN=replace-with-any-random-string

# ─────────────────────────────────────────────
# YOUTUBE DATA API — console.cloud.google.com
# Per-client OAuth tokens live in Supabase; these are
# only used for local single-client testing.
# ─────────────────────────────────────────────
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────
# GOOGLE BUSINESS PROFILE API
# Same OAuth client as YouTube can be reused (Google Cloud project)
# ─────────────────────────────────────────────
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────
# CRON / WEBHOOK SECURITY
# Random strings you generate yourself. Used to verify
# requests to /api/cron/* actually come from your cron pinger.
# ─────────────────────────────────────────────
CRON_SECRET=replace-with-any-random-string

# ─────────────────────────────────────────────
# ADMIN PANEL LOGIN
# Single shared password for the /admin client-management panel
# (add/edit clients, connect their social platforms via OAuth).
# Pick something strong — anyone with this password can manage
# every client's connected accounts.
# ─────────────────────────────────────────────
ADMIN_PASSWORD=replace-with-a-strong-password
